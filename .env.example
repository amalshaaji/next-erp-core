DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=True
# Set True for a hosted Render preview using Clerk test keys. Keep False for production.
DJANGO_PREVIEW=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
# Keep the service-role key server-side only; required for admin invitations.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWKS_URL=
SUPABASE_ISSUER=
# Shared cache (Redis). Required when DJANGO_DEBUG=False.
CACHE_URL=
CACHE_KEY_PREFIX=bill-tech
# Supabase PostgreSQL URL. Leave empty for local SQLite development.
DATABASE_URL=
DB_CONN_MAX_AGE=60
DB_DISABLE_SERVER_SIDE_CURSORS=False
# Production only; enable after confirming every subdomain supports HTTPS.
DJANGO_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_HSTS_PRELOAD=False
